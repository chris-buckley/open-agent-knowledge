{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schema/system",
  "title": "BaseSystem",
  "description": "An extensible structural contract for a system made of nodes, relationships, and metadata.",
  "$ref": "#/$defs/System",
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
      "description": "An application identifier. JSON Schema validates only its string shape."
    },
    "Metadata": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "owner"
      ],
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "NodeCore": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind",
        "label"
      ]
    },
    "ServiceNode": {
      "title": "ServiceNode",
      "allOf": [
        {
          "$ref": "#/$defs/NodeCore"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "service"
            },
            "endpoint": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "endpoint"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "StoreNode": {
      "title": "StoreNode",
      "allOf": [
        {
          "$ref": "#/$defs/NodeCore"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "store"
            },
            "engine": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "engine"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "ContainerNode": {
      "title": "ContainerNode",
      "allOf": [
        {
          "$ref": "#/$defs/NodeCore"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "container"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Node"
              },
              "default": []
            }
          },
          "required": [
            "children"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "ExtensionNode": {
      "title": "ExtensionNode",
      "description": "An open node branch reserved for kinds added by a separate contract.",
      "allOf": [
        {
          "$ref": "#/$defs/NodeCore"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "not": {
                "enum": [
                  "service",
                  "store",
                  "container"
                ]
              }
            }
          }
        }
      ]
    },
    "Node": {
      "title": "Node",
      "oneOf": [
        {
          "$ref": "#/$defs/ServiceNode"
        },
        {
          "$ref": "#/$defs/StoreNode"
        },
        {
          "$ref": "#/$defs/ContainerNode"
        },
        {
          "$ref": "#/$defs/ExtensionNode"
        }
      ]
    },
    "RelationshipCore": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "$ref": "#/$defs/Identifier"
        },
        "to": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "id",
        "kind",
        "from",
        "to"
      ]
    },
    "ContainsRelationship": {
      "title": "ContainsRelationship",
      "allOf": [
        {
          "$ref": "#/$defs/RelationshipCore"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "contains"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "StoresInRelationship": {
      "title": "StoresInRelationship",
      "allOf": [
        {
          "$ref": "#/$defs/RelationshipCore"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "stores-in"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ExtensionRelationship": {
      "title": "ExtensionRelationship",
      "description": "An open relationship branch reserved for kinds added by a separate contract.",
      "allOf": [
        {
          "$ref": "#/$defs/RelationshipCore"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "not": {
                "enum": [
                  "contains",
                  "stores-in"
                ]
              }
            }
          }
        }
      ]
    },
    "Relationship": {
      "title": "Relationship",
      "oneOf": [
        {
          "$ref": "#/$defs/ContainsRelationship"
        },
        {
          "$ref": "#/$defs/StoresInRelationship"
        },
        {
          "$ref": "#/$defs/ExtensionRelationship"
        }
      ]
    },
    "System": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Node"
          },
          "uniqueItems": true
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Relationship"
          },
          "uniqueItems": true
        },
        "metadata": {
          "$ref": "#/$defs/Metadata"
        }
      },
      "required": [
        "id",
        "nodes",
        "relationships",
        "metadata"
      ]
    }
  }
}
