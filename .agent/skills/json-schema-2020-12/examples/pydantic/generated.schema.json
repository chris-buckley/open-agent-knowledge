          "description": "An application identifier; target existence needs a graph-wide check.",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "container",
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "children": {
          "items": {
            "discriminator": {
              "mapping": {
                "container": "#/$defs/ContainerNode",
                "loan-product": "#/$defs/LoanProductNode",
                "repayment-structure": "#/$defs/RepaymentStructureNode",
                "service": "#/$defs/ServiceNode",
                "store": "#/$defs/StoreNode"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ServiceNode"
              },
              {
                "$ref": "#/$defs/StoreNode"
              },
              {
                "$ref": "#/$defs/ContainerNode"
              },
              {
                "$ref": "#/$defs/LoanProductNode"
              },
              {
                "$ref": "#/$defs/RepaymentStructureNode"
              }
            ]
          },
          "title": "Children",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "children"
      ],
      "title": "ContainerNode",
      "type": "object"
    },
