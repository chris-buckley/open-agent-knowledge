{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schema/tree",
  "title": "TreeNode",
  "$dynamicAnchor": "node",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "children": {
      "type": "array",
      "items": {
        "$dynamicRef": "#node"
      }
    }
  },
  "required": [
    "name",
    "children"
  ]
}
